# Copy to terraform.tfvars in this directory and replace the two placeholders.
# Never put AWS credentials or SSH private key contents in this file.
aws_region   = "ap-southeast-1"
project_name = "terraform-aws-lab"
environment  = "dev"

vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr  = "10.0.1.0/24"
private_subnet_cidr = "10.0.2.0/24"
availability_zone  = "ap-southeast-1a"

public_instance_count  = 1
private_instance_count = 1

instance_type   = "t3.micro"
ami_id          = "REPLACE_WITH_VALID_AMI_ID"
key_name        = "lab_key"
public_key_path = "key_pair/lab_key.pub"

# Replace with <YOUR_PUBLIC_IP>/32; example syntax: "203.0.113.10/32".
# 203.0.113.10 is a documentation address, not a usable access IP.
allowed_ssh_cidr = "REPLACE_WITH_YOUR_PUBLIC_IP/32"
